language "law.core" version "0.2";
package scrum.guide version "0.1.0";
namespace "urn:scrum:clir:guide";

// Книга «Построения», глава 8 (docs/books/postroeniya/PLAN.ru.md §7.1):
// презумпция видимости работы (раздел 3-1 руководства) стоит, пока
// сокрытие не установлено. Пара к сценарию 08.
test "urn:query:scrum-test-work-presumed-visible" {
    given {
        context { decision_time @2026-09-01T12:00:00Z; knowledge_time @2026-09-01T12:00:00Z; legal_time @2026-09-01; timezone "UTC"; }
        assert "sg-t7-a": scrum_team(entity_ref("urn:scrum:team:t")) { origin case_input; }
    }
    evaluate truth(work_visible(entity_ref("urn:scrum:team:t")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(WorkPresumedVisible);
}
