// Source-модель: закреплённые байты книги II «Начал» (II.12, II.13)
// и целочисленное прочтение I.20/I.47/I.48 книги I.
//
// ФАЙЛ ПОРОЖДАЕТСЯ. Правится только генератором —
// `corpus/tools/sources/sync/sync_euclid_pythagoras_fragments.py`.
// Книга I в знаменатель §33.1 не входит: её байты — у
// `grc.euclid.stoicheia_i`. INTEGER_READING — источник SCHOOL_LAYER.

language "law.core" version "0.2";
package grc.eukleides.pythagoras version "0.1.0";
namespace "urn:grc:eukleides:clir:pythagoras";

source STOICHEIA_II {
    kind treatise;
    jurisdiction "none";
    number "Euclidis Elementa II";
    label grc official "Στοιχείων β΄";
    label ru unofficial "Начала, книга II";
}

edition STOICHEIA_II_GRC of STOICHEIA_II {
    label grc official "Προτάσεις ιβ΄, ιγ΄";
    label ru unofficial "Греческий текст, предложения 12, 13";
    language grc;
    officiality unofficial;
    materialization_status PINNED_UNOFFICIAL_COPY;
}

