language "law.core" version "0.2";
package myco.opredelitel version "0.1.0";
namespace "urn:myco:clir:opredelitel";

source MYCO_RESTATEMENT { kind doctrine; jurisdiction "none"; number "MYCO-RESTATEMENT-1"; label ru-KZ unofficial "Авторское изложение определителя грибов"; }
edition MYCO_RU of MYCO_RESTATEMENT { language ru-KZ; officiality unofficial; materialization_status PINNED_OFFICIAL_BYTES; }
publication MYCO_RU_TEXT of MYCO_RU { media_type "text/plain; charset=utf-8"; uri "urn:myco:restatement:opredelitel:ru"; retrieved_at @2026-08-31T00:00:00Z; content_hash "sha256:735bc3286cda9dafa573bac55b382aa1319bd97e3e5cae6d58583c5efe301f81"; local_path "sources/opredelitel/ru.txt"; }

fragment MYCO_ART1 in MYCO_RU { kind article; locator "article/1"; text ru-KZ official """Настоящее изложение устанавливает ограниченный ключ для десяти видов грибов. Оно не является руководством по сбору, биологическим определителем и медицинской рекомендацией; сезон, биотоп и наблюдаемые признаки являются фактами конкретного дела."""; content_hash "sha256:f4ac29c7c50889fbaca0a316ba8f7084580ecf9a65d615bb1943813160c35f9c"; }
fragment MYCO_ART2 in MYCO_RU { kind article; locator "article/2"; text ru-KZ official """Признаками ключа являются: гименофор, кольцо на ножке, вольва у основания, цвет пластинок, цвет спорового отпечатка, наличие млечного сока и изменение мякоти на срезе. Признак считается установленным только когда он проверен в деле; отсутствие записи о признаке не является его отрицанием."""; content_hash "sha256:0362d325ba57aa9185855086ecc5ce42c9a17f7f7328258d5676e8295d354e1b"; }
fragment MYCO_ART3 in MYCO_RU { kind article; locator "article/3"; text ru-KZ official """Гименофор в настоящем срезе описывается как пластинки, складки, ячейки либо трубочки. Кольцо и вольва описываются как наличествующие либо отсутствующие. Для видов без пластинок цвет пластинок записывается как неприменимый."""; content_hash "sha256:e4fcaa914764755ca7e340f8ff2e600d8c1f636d36c8c12eeca42c986f55f3a0"; }
fragment MYCO_ART4 in MYCO_RU { kind article; locator "article/4"; text ru-KZ official """Вид устанавливается только полным совпадением всех признаков его строки ключа. Неполный ключ, в том числе отсутствие спорового отпечатка или невыкопанная вольва, не устанавливает никакого вида."""; content_hash "sha256:59025a9050b5b4cd40c25d94b61c6fb4e1d13805554b314ec54c378b48693c54"; }
fragment MYCO_ART5 in MYCO_RU { kind article; locator "article/5"; text ru-KZ official """Бледная поганка: пластинки, кольцо есть, вольва есть, пластинки белые, отпечаток белый, млечного сока нет, мякоть на срезе не меняется. Шампиньон обыкновенный: пластинки, кольцо есть, вольвы нет, пластинки розовые, отпечаток тёмно-коричневый, млечного сока нет, мякоть на срезе розовеет."""; content_hash "sha256:657b7fbdda4747f211d969c2d78844e13fffd0ff174fbb01a758453dc92cedf8"; }
fragment MYCO_ART6 in MYCO_RU { kind article; locator "article/6"; text ru-KZ official """Сыроежка зелёная: пластинки, кольца и вольвы нет, пластинки белые, отпечаток белый, млечного сока нет, мякоть не меняется. Лисичка настоящая: складки, кольца и вольвы нет, пластинки неприменимы, отпечаток бледно-жёлтый, млечного сока нет, мякоть не меняется. Ложная лисичка: пластинки, кольца и вольвы нет, пластинки оранжевые, отпечаток белый, млечного сока нет, мякоть не меняется."""; content_hash "sha256:0231a32280db9726a2d0d981afe05c7014194d9a3be24bb067aa7101c6617763"; }
fragment MYCO_ART7 in MYCO_RU { kind article; locator "article/7"; text ru-KZ official """Опёнок осенний: пластинки, кольцо есть, вольвы нет, пластинки светлые, отпечаток белый, млечного сока нет, мякоть не меняется. Галерина окаймлённая: пластинки, кольцо есть, вольвы нет, пластинки коричневые, отпечаток ржаво-коричневый, млечного сока нет, мякоть не меняется."""; content_hash "sha256:5d04ca03700490e34bdf4eef6097383fa2a6584c02646cfafb29525c808f9804"; }
fragment MYCO_ART8 in MYCO_RU { kind article; locator "article/8"; text ru-KZ official """Свинушка тонкая: пластинки, кольца и вольвы нет, пластинки охристые, отпечаток коричневый, млечного сока нет, мякоть буреет. Строчок обыкновенный: складки, кольца и вольвы нет, пластинки неприменимы, отпечаток кремовый, млечного сока нет, мякоть не меняется. Сморчок съедобный: ячейки, кольца и вольвы нет, пластинки неприменимы, отпечаток кремовый, млечного сока нет, мякоть не меняется."""; content_hash "sha256:0335f689b244711b5fe1441ed87d881bcf492798b7fab337472dc4b29702f912"; }
fragment MYCO_ART9 in MYCO_RU { kind article; locator "article/9"; text ru-KZ official """Классы настоящего изложения: съедобен — шампиньон обыкновенный, сыроежка зелёная, лисичка настоящая и сморчок съедобный; условно съедобен — строчок обыкновенный; ядовит — свинушка тонкая и ложная лисичка; смертельно ядовит — бледная поганка и галерина окаймлённая. Съедобность выводится только для установленного вида класса «съедобен»."""; content_hash "sha256:15637b136c3b5e63606d27895edb0a582847a492f863a5f4836419e49205c7d2"; }
fragment MYCO_ART10 in MYCO_RU { kind article; locator "article/10"; text ru-KZ official """Перечень смертельно ядовитых видов закрыт: бледная поганка и галерина окаймлённая. Невхождение в этот перечень не является выводом съедобности."""; content_hash "sha256:3a9283a9dcfb32c955e96bedbe51bda3ee5b6dcf873ae1acaa828be180b65b44"; }
fragment MYCO_ART11 in MYCO_RU { kind article; locator "article/11"; text ru-KZ official """Строчок обыкновенный допускается к пищевому употреблению только после двукратного отваривания не менее пятнадцати минут каждый раз со сливом отвара. Сырой либо однократно обработанный строчок не получает вердикта edible_prepared."""; content_hash "sha256:5ad59ef682fd9883ff459f934fd2848cdf00078d220fa9ff8517c06e2f3af548"; }
fragment MYCO_ART12 in MYCO_RU { kind article; locator "article/12"; text ru-KZ official """Латентность симптомов: менее двух часов — раздражающий синдром; от двух до шести часов — желудочно-кишечный синдром; более шести часов — отсроченный гепатотоксический синдром. Быстрые симптомы в этой таблице не означают более опасный синдром."""; content_hash "sha256:e752c9a2cc921061e412b37d14e93bacd0012ba728af00ffa3a084cbef216ff2"; }
fragment MYCO_ART13 in MYCO_RU { kind article; locator "article/13"; text ru-KZ official """Нераскрытый ключ требует суждения миколога. Орган суждения устанавливает вид только своим решением; настоящее изложение не вычисляет микроскопию, споруляцию, сезон или биотоп."""; content_hash "sha256:8f7393688d059e38f7186dde46e753cd588fef6f24712b2fe22810b986d72d60"; }
fragment MYCO_ART14 in MYCO_RU { kind article; locator "article/14"; text ru-KZ official """Виды вне десятивидового среза настоящим изложением не разрешаются. Советская позиция о свинушке как условно съедобной и современная позиция о ней как ядовитой остаются расходящимися свидетельствами. Финская и немецкая позиции о строчке также остаются расходящимися свидетельствами; даты жизненного цикла редакций не устанавливаются."""; content_hash "sha256:25fc4fa524804d3fe9d21e90434be466a42bfd84030c5900f9d7968896f3ce32"; }
