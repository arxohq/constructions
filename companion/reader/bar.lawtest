language "law.core" version "0.2";
package myco.opredelitel version "0.1.0";
namespace "urn:myco:clir:opredelitel";

// Книга «Построения», глава 8: другая сторона презумпции ст. 9 — полный
// ключ шампиньона даёт съедобный вердикт, и дефитер снимает запрет.
// Снятие поддержки, а не поддержка отрицания: food_barred → NEITHER,
// не FALSE_ONLY. Декларативная пара к сцене MYCO-EDIBLE-VERDICT-LIFTS-THE-BAR.
test "urn:query:myco-t03-book-verdict-lifts-bar" {
    given {
        context { decision_time @2026-08-31T12:00:00Z; knowledge_time @2026-08-31T12:00:00Z; legal_time @2026-08-31; timezone "Europe/Moscow"; }
        assert "myco-t03-1": specimen(entity_ref("urn:case:myco:t03")) { origin case_input; }
        assert "myco-t03-2": hymenophore(entity_ref("urn:case:myco:t03"), Gills) { origin case_input; }
        assert "myco-t03-3": ring(entity_ref("urn:case:myco:t03"), Present) { origin case_input; }
        assert "myco-t03-4": volva(entity_ref("urn:case:myco:t03"), Absent) { origin case_input; }
        assert "myco-t03-5": gill_color(entity_ref("urn:case:myco:t03"), Pink) { origin case_input; }
        assert "myco-t03-6": spore_print(entity_ref("urn:case:myco:t03"), DarkBrown) { origin case_input; }
        assert "myco-t03-7": latex(entity_ref("urn:case:myco:t03"), Absent) { origin case_input; }
        assert "myco-t03-8": flesh_change(entity_ref("urn:case:myco:t03"), Pinking) { origin case_input; }
    }
    evaluate truth(food_barred(entity_ref("urn:case:myco:t03")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
