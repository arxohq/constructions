language "law.core" version "0.2";
package de.kafka.vor_dem_gesetz version "0.1.0";
namespace "urn:de:kafka:clir:vor-dem-gesetz";

// «Ich gehe jetzt und schließe ihn» — будущее время, и притча обрывается на
// этих словах. Пакет утверждает ровно засвидетельствованное: ОБЪЯВЛЕНИЕ,
// сделанное тем, кто вправе его сделать, а не совершившееся закрытие.
test "urn:query:vor-dem-gesetz-closure-declared" {
    given {
        context { decision_time @2026-08-30T12:00:00Z; knowledge_time @2026-08-30T12:00:00Z; legal_time @1000-01-05; timezone "UTC"; }
        assert "vg11-1": letzte_auskunft_erteilt(entity_ref("urn:de:kafka:clir:vor-dem-gesetz#Mann")) { origin case_input; }
    }
    evaluate truth(schliessung_erklaert(entity_ref("urn:de:kafka:clir:vor-dem-gesetz#Tor")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
