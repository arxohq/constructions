language "law.core" version "0.2";
package de.kafka.vor_dem_gesetz version "0.1.0";
namespace "urn:de:kafka:clir:vor-dem-gesetz";

// Предназначенность врат одному лицу НЕВЫВОДИМА до последней реплики — и не
// потому, что спрятана, а потому, что до неё её нечем вывести. Пара к делу
// 08: разница в один факт.
test "urn:query:vor-dem-gesetz-destination-unknown" {
    given {
        context { decision_time @2026-08-30T12:00:00Z; knowledge_time @2026-08-30T12:00:00Z; legal_time @1000-01-05; timezone "UTC"; }
        assert "vg07-1": letzte_frage_gestellt(entity_ref("urn:de:kafka:clir:vor-dem-gesetz#Mann")) { origin case_input; }
    }
    evaluate truth(eingang_nur_fuer(entity_ref("urn:de:kafka:clir:vor-dem-gesetz#Mann")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
