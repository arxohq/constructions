        }

        assert "assert-f0": ohne_erlaubnis_eingetreten(Mann) {
            origin case_input;
        }
    }

    evaluate truth(verbot_verletzt(Mann));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}

