test "VG-14 просьбы, дары и блохи вместе: ответ тот же — решает привратник" {
    given {
        context {
            decision_time @1000-01-05T12:00:00Z;
            knowledge_time @1000-01-05T12:00:00Z;
            legal_time @1000-01-05;
            timezone "UTC";
        }

        assert "assert-f0": schemel_angenommen(Mann) {
            origin case_input;
        }

        assert "assert-f1": bitte_vorgebracht(Mann) {
            origin case_input;
        }

        assert "assert-f2": gabe_angeboten(Mann) {
            origin case_input;
        }

        assert "assert-f3": gabe_angenommen(DerTuerhueter, Mann) {
            origin case_input;
        }

        assert "assert-f4": floehe_gebeten(Mann) {
            origin case_input;
        }
    }

    evaluate truth(einlass_gestattet(Mann));
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect truth_status == NEITHER;
    expect judgment_requests(1);
    expect judgment_request(tuerhueter_gewaehrt_einlass);
}

test "VG-15 «Закон доступен каждому и всегда» — истинно как мысль просителя и не двигает вопрос о впуске" {
    given {
        context {
            decision_time @1000-01-05T12:00:00Z;
            knowledge_time @1000-01-05T12:00:00Z;
            legal_time @1000-01-05;
            timezone "UTC";
        }
    }

    evaluate truth(zugang_fuer_jeden_erwartet(Mann));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;

    evaluate truth(einlass_gestattet(Mann));
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect truth_status == NEITHER;
}
