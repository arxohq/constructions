language "law.core" version "0.2";
package de.kafka.vor_dem_gesetz version "0.1.0";
namespace "urn:de:kafka:clir:vor-dem-gesetz";

// Сценарии перенесены из прежнего Python-раннера семейства `vor_dem_gesetz`.
// Заголовки — прежние ID сценариев (scenario-manifest); ожидания
// выведены из ПРЕЖНИХ проверок, а не из ответов движка.

test "VG-01 впуск без ответа привратника: REQUIRES_JUDGMENT, орган Tuerhueter" {
    given {
        context {
            decision_time @1000-01-05T12:00:00Z;
            knowledge_time @1000-01-05T12:00:00Z;
            legal_time @1000-01-05;
            timezone "UTC";
        }
    }

    evaluate truth(einlass_gestattet(Mann));
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect truth_status == NEITHER;
    expect judgment_requests(1);
    expect judgment_request(tuerhueter_gewaehrt_einlass);
}

test "VG-02 привратник дал впуск: вывод замкнулся" {
    given {
        context {
            decision_time @1000-01-05T12:00:00Z;
            knowledge_time @1000-01-05T12:00:00Z;
            legal_time @1000-01-05;
            timezone "UTC";
        }

        assert "assert-adj0": tuerhueter_gewaehrt_einlass(Mann) {
            origin adjudicated;
        }
    }

    evaluate truth(einlass_gestattet(Mann));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect judgment_requests(0);
}

test "VG-03 привратник отказал: вопрос закрыт, а отрицание всё равно не выводится — открытый мир" {
    given {
        context {
            decision_time @1000-01-05T12:00:00Z;
            knowledge_time @1000-01-05T12:00:00Z;
            legal_time @1000-01-05;
            timezone "UTC";
        }

        assert "assert-adj0": not tuerhueter_gewaehrt_einlass(Mann) {
            origin adjudicated;
        }
    }

    evaluate truth(einlass_gestattet(Mann));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
    expect judgment_requests(0);
}

