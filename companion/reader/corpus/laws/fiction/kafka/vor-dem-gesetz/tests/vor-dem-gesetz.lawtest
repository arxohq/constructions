test "VG-08 дары приняты — притязания не возникло, и сказал это сам принявший" {
    given {
        context {
            decision_time @1000-01-05T12:00:00Z;
            knowledge_time @1000-01-05T12:00:00Z;
            legal_time @1000-01-05;
            timezone "UTC";
        }

        assert "assert-f0": gabe_angeboten(Mann) {
            origin case_input;
        }

        assert "assert-f1": gabe_angenommen(DerTuerhueter, Mann) {
            origin case_input;
        }
    }

    evaluate truth(kein_anspruch_aus_annahme(Mann));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}

