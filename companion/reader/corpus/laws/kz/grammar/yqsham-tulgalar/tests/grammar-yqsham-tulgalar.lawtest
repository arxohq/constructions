language "law.core" version "0.2";
package kz.grammar.yqsham_tulgalar version "0.1.0";
namespace "urn:kz:grammar:clir:yqsham-tulgalar";

// Сценарии перенесены из прежнего Python-раннера семейства `grammar_yqsham_tulgalar`.
// Заголовки — прежние ID сценариев (scenario-manifest); ожидания
// выведены из ПРЕЖНИХ проверок, а не из ответов движка.

test "KZ-YQS-01-PROHIBITION-WORKS-BOTH-WAYS" {
    given {

        assert "assert-a0": yqsham_turinde_berilgen(entity_ref("urn:kz:grammar:clir:yqsham-tulgalar#Kep")) {
            origin case_input;
        }
    }

    evaluate truth(berilgen_turinde_aitylady(entity_ref("urn:kz:grammar:clir:yqsham-tulgalar#Kep")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
    expect any_applied(YqshamBerilgenTurinde);

    evaluate truth(yqshamdy_tolyq_etip_aituga_bolmaidy(entity_ref("urn:kz:grammar:clir:yqsham-tulgalar#Kep")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
    expect any_applied(YqshamdyTolyqAituBolmaidy);

    evaluate truth(tolyqty_qysqartyp_aituga_bolmaidy(entity_ref("urn:kz:grammar:clir:yqsham-tulgalar#Kep")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
    expect issues_within(info);
}

