test "KZ-YQS-02-VERSE-PERMITS-IT-DOES-NOT-REQUIRE" {
    given {

        assert "assert-a0": auyspaly_shaq_ushinshi_zhaq_zhalgauy(entity_ref("urn:kz:grammar:clir:yqsham-tulgalar#Tildeset")) {
            origin case_input;
        }
    }

    evaluate truth(zhalang_d_turinde_qoldanyluy_mumkin(entity_ref("urn:kz:grammar:clir:yqsham-tulgalar#Tildeset")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
    expect issues_within(info);
}

test "KZ-YQS-02-VERSE-PERMITS-IT-DOES-NOT-REQUIRE/2" {
    given {
        context {
            decision_time @2026-08-26T12:00:00+05:00;
            knowledge_time @2026-08-26T12:00:00+05:00;
            legal_time @2024-10-01;
            timezone "Asia/Qyzylorda";
        }

        assert "assert-a0": auyspaly_shaq_ushinshi_zhaq_zhalgauy(entity_ref("urn:kz:grammar:clir:yqsham-tulgalar#Tildeset")) {
            origin case_input;
        }

        assert "assert-a1": olengde_olshem_uiqas_talap_etedi(entity_ref("urn:kz:grammar:clir:yqsham-tulgalar#Tildeset")) {
            origin case_input;
        }
    }

    evaluate truth(zhalang_d_turinde_qoldanyluy_mumkin(entity_ref("urn:kz:grammar:clir:yqsham-tulgalar#Tildeset")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
    expect any_applied(OlengdeZhalangD);

    evaluate truth(t_dybysymen_de_aitylady(entity_ref("urn:kz:grammar:clir:yqsham-tulgalar#Tildeset")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
    expect any_applied(OlengdeTDybysymenDe);
}
