// The 2020 Scrum Guide (Швабер, Сазерленд) — регламент фреймворка как акт.
//
// Общие типы и эмпирические отношения, нужные двум и более модулям
// (docs/PACKAGE-LAYOUT.ru.md). Константы и предметные отношения — при
// модуле-владельце. Модули зеркалят главы источника:
//
//   02-theory.law      — разделы 2, 3-1…3-3: определение и три столпа
//   03-team.law        — разделы 5…5-3: команда и три ответственности
//   04-events.law      — разделы 6…6-5: спринт-контейнер, таймбоксы, отмена
//   05-artifacts.law   — разделы 7…7-3-1: артефакты, обязательства, DoD
//   06-end-note.law    — раздел 8: неделимость Scrum
//
// ═══ ЧЕГО В ПАКЕТЕ НЕТ, И ЭТО РЕШЕНИЕ ════════════════════════════════════
//
// 1. **Ответственность записана тремя эмпирическими отношениями, а не одним
//    с перечислением.** `product_owner_of`, `scrum_master_of`, `developer_of`
//    вместо `accountable(p, t, Role)`: член перечисления в generator-е
//    comprehension §52.1 не связан (LDC-E1317), а «владелец продукта — один
//    человек, не комитет» считается агрегатом §59 ровно по этому отношению.
// 2. **Таймбоксы меряются термами §84.1**, не приходят фактом с величиной в
//    имени: `minutes_between(start, end)` против порога в минутах. Порог
//    «восемь часов для месячного спринта» прочитан как ПОТОЛОК для всякого
//    спринта: «for shorter Sprints, the event is usually shorter» — короче
//    обычно, но не обязательно, а дольше восьми часов нельзя никогда.
// 3. **Длина спринта — календарный месяц**, `add_calendar_period` §84.2, а не
//    тридцать дней: «one month or less».
// 4. **Запреты записаны обязанностями ПОДДЕРЖАНИЯ с презумпцией** (приём
//    BCP 14 и конституции Claude): позиция воздержания §130 в срезе 0.1 не
//    получает VIOLATED никогда, а «изменение, угрожающее цели спринта» —
//    главный ожидаемый ответ. Презумпция + поражающее правило с отрицательной
//    головой + приоритет §116; тело поражающего повторяет конъюнкты
//    презумпции, иначе страта §111 разведёт их и приоритет промолчит.
// 5. **«Typically 10 or fewer people» — не норма.** Число названо как
//    наблюдение, а не как предел; в пакете его нет.
//
// ЮРИДИЧЕСКАЯ ОГОВОРКА. Пакет описывает Руководство как регламент частного
// нормодателя: сила организационная, санкция — потеря имени «Scrum» (раздел
// 8). Это не методология внедрения и не замена Scrum Master-у.

language "law.core" version "0.2";
package scrum.guide version "0.1.0";
namespace "urn:scrum:clir:guide";

// --- Разрешение даты в мгновение §82.1 ------------------------------------
//
// Спринт назван ДАТАМИ («fixed length events of one month or less»), а его
// события — МГНОВЕНИЯМИ (таймбокс планирования в часах, Daily Scrum в
// минутах). Сравнение `Date` с `Instant` без политики §82.1 запрещено, и с
// DECISION-0156 отказ поднимается фактически (`TEMPORAL_RESOLUTION_POLICY_
// MISSING`), а не молчит. Руководство юрисдикции не имеет и границы суток не
// называет: взято UTC с полуночью — тем же поясом, в котором записаны все
// мгновения сцен. Пояса с переходом на летнее время политика 0.2 не
// выражает (§82.1), и Scrum Guide такого не требует.
temporal_resolution_policy ScrumUtcDay {
    utc_offset "+00:00";
    day_boundary "00:00:00";
    timezone "UTC";
}

// --- Сущности -----------------------------------------------------------

entity Team { label en official "Scrum Team"; }
entity Person { label en official "person"; }
entity Organization { label en official "organization the Scrum Team works within"; }
entity Product { label en official "product"; }
entity Sprint { label en official "Sprint"; }
entity ScrumEvent { label en official "Scrum event: Sprint Planning, Daily Scrum, Sprint Review or Sprint Retrospective"; }
entity BacklogItem { label en official "Product Backlog item"; }
entity Goal { label en official "Product Goal or Sprint Goal"; }
entity Aspect { label en official "aspect of the process or of the materials being produced"; }

pub enum EventKind {
    label en official "the four formal events contained in the Sprint";
    SprintPlanning,
    DailyScrum,
    SprintReview,
    SprintRetrospective
}

// --- Состав команды (раздел 5) — читается всеми модулями --------------------

relation scrum_team(t: Team) kind empirical {
    label en official "the team is organized as a Scrum Team";
}
relation organization_of(t: Team, org: Organization) kind empirical {
    label en official "the Scrum Team is structured and empowered by the organization";
}
relation product_owner_of(p: Person, t: Team) kind empirical {
    label en official "the person holds the Product Owner accountability in the Scrum Team";
}
relation scrum_master_of(p: Person, t: Team) kind empirical {
    label en official "the person holds the Scrum Master accountability in the Scrum Team";
}
relation developer_of(p: Person, t: Team) kind empirical {
    label en official "the person is one of the Developers of the Scrum Team";
}
relation works_on_product(t: Team, prod: Product) kind empirical {
    label en official "the Scrum Team works on the product";
}

// --- Спринт и события (раздел 6) — читаются командой и артефактами ---------

relation sprint_of_team(s: Sprint, t: Team) kind empirical {
    label en official "the Sprint is a Sprint of the Scrum Team";
}
relation sprint_starts(s: Sprint, d: Date) kind empirical {
    label en official "the Sprint starts on the date";
}
relation sprint_ends(s: Sprint, d: Date) kind empirical {
    label en official "the Sprint ends on the date";
}
relation event_of_sprint(e: ScrumEvent, s: Sprint) kind empirical {
    label en official "the event is held within the Sprint";
}
relation event_kind(e: ScrumEvent, k: EventKind) kind empirical {
    label en official "the event is of the named kind";
}
relation event_started_at(e: ScrumEvent, at: Instant) kind empirical {
    label en official "the event started at the instant";
}
relation event_ended_at(e: ScrumEvent, at: Instant) kind empirical {
    label en official "the event ended at the instant";
}

// Домены замыканий §70 (v1 закрывает только унарный предикат). Обязанность
// ДОСТИЖЕНИЯ получает VIOLATED после окна только через полноту §137 — если
// условие закрыто: спринт или событие, о котором дело молчит, условия НЕ
// достигло. Вне домена — UNDETERMINED, а не нарушение.
relation checked_sprint(s: Sprint) kind empirical {
    label en official "the Sprint is in the closed domain of Sprints whose outcomes are recorded";
}
relation checked_event(e: ScrumEvent) kind empirical {
    label en official "the event is in the closed domain of events whose preparation is recorded";
}

// Named equivalent of the pinned test context policy (language 0.2).
deadline policy CONSTRUCTIONS_SAME_DAY_NO_ROLL_MONTH_END_LAST_DAY { start_count same_day; include_end true; roll no_roll; month_end last_day_of_month; }
