language "law.core" version "0.2";
package scrum.guide version "0.1.0";
namespace "urn:scrum:clir:guide";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-DEVELOPERSPARTICIPATEINDAILYSCRUM" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": developer_of(entity_ref("urn:law:catalog:developersparticipateindailyscrum:v0"), entity_ref("urn:law:catalog:developersparticipateindailyscrum:v1")) { origin case_input; }
        assert "cat-1": event_kind(entity_ref("urn:law:catalog:developersparticipateindailyscrum:v3"), DailyScrum) { origin case_input; }
        assert "cat-2": sprint_of_team(entity_ref("urn:law:catalog:developersparticipateindailyscrum:v2"), entity_ref("urn:law:catalog:developersparticipateindailyscrum:v1")) { origin case_input; }
        assert "cat-3": event_of_sprint(entity_ref("urn:law:catalog:developersparticipateindailyscrum:v3"), entity_ref("urn:law:catalog:developersparticipateindailyscrum:v2")) { origin case_input; }
    }
    evaluate truth(daily_scrum_participant(entity_ref("urn:law:catalog:developersparticipateindailyscrum:v0"), entity_ref("urn:law:catalog:developersparticipateindailyscrum:v3")));
    expect truth_status == TRUE_ONLY;
}
