language "law.core" version "0.2";
package scrum.guide version "0.1.0";
namespace "urn:scrum:clir:guide";

// Раздел 6-3: «The Daily Scrum is a 15-minute event». Длительность — терм
// minutes_between §84.1, не факт с величиной в имени; 16 минут — перебор.
test "urn:query:scrum-test-daily-scrum-overrun" {
    given {
        context { decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; legal_time @2026-09-15; timezone "UTC"; }
        assert "sg-t3-a": event_kind(entity_ref("urn:scrum:event:daily"), DailyScrum) { origin case_input; }
        assert "sg-t3-b": event_started_at(entity_ref("urn:scrum:event:daily"), @2026-09-02T09:00:00Z) { origin case_input; }
        assert "sg-t3-c": event_ended_at(entity_ref("urn:scrum:event:daily"), @2026-09-02T09:16:00Z) { origin case_input; }
    }
    evaluate truth(timebox_exceeded(entity_ref("urn:scrum:event:daily")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
