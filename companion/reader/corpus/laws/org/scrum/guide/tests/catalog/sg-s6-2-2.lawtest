language "law.core" version "0.2";
package scrum.guide version "0.1.0";
namespace "urn:scrum:clir:guide";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-DEVELOPERSSELECTITEMS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": sprint_of_team(entity_ref("urn:law:catalog:developersselectitems:v2"), entity_ref("urn:law:catalog:developersselectitems:v3")) { origin case_input; }
        assert "cat-1": selects_for_sprint(entity_ref("urn:law:catalog:developersselectitems:v0"), entity_ref("urn:law:catalog:developersselectitems:v1"), entity_ref("urn:law:catalog:developersselectitems:v2")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(SelectBacklogItems, ACTIVE);
}
