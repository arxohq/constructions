language "law.core" version "0.2";
package scrum.guide version "0.1.0";
namespace "urn:scrum:clir:guide";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-EACHEVENTISANINSPECTIONOPPORTUNITY" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": event_kind(entity_ref("urn:law:catalog:eacheventisaninspectionopportunity:v0"), entity_ref("urn:law:catalog:eacheventisaninspectionopportunity:v2")) { origin case_input; }
        assert "cat-1": event_of_sprint(entity_ref("urn:law:catalog:eacheventisaninspectionopportunity:v0"), entity_ref("urn:law:catalog:eacheventisaninspectionopportunity:v1")) { origin case_input; }
    }
    evaluate truth(formal_inspection_opportunity(entity_ref("urn:law:catalog:eacheventisaninspectionopportunity:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-FAILURETOOPERATELOSESOPPORTUNITY" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": event_not_operated_as_prescribed(entity_ref("urn:law:catalog:failuretooperatelosesopportunity:v0"), entity_ref("urn:law:catalog:failuretooperatelosesopportunity:v1")) { origin case_input; }
    }
    evaluate truth(inspection_opportunity_lost(entity_ref("urn:law:catalog:failuretooperatelosesopportunity:v0"), entity_ref("urn:law:catalog:failuretooperatelosesopportunity:v1")));
    expect truth_status == TRUE_ONLY;
}
