language "law.core" version "0.2";
package scrum.guide version "0.1.0";
namespace "urn:scrum:clir:guide";

// Раздел 6-1: «Only the Product Owner has the authority to cancel the
// Sprint». Заявление разработчика — упражнение полномочия без
// действительности: эффект не материализуется, ответ NEITHER, а не отказ.
test "urn:query:scrum-test-developer-cancel" {
    given {
        context { decision_time @2026-09-15T12:00:00Z; knowledge_time @2026-09-15T12:00:00Z; legal_time @2026-09-15; timezone "UTC"; }
        assert "sg-t4-a": sprint_of_team(entity_ref("urn:scrum:sprint:s"), entity_ref("urn:scrum:team:t")) { origin case_input; }
        assert "sg-t4-b": developer_of(entity_ref("urn:scrum:person:dev"), entity_ref("urn:scrum:team:t")) { origin case_input; }
        assert "sg-t4-c": cancels_sprint(entity_ref("urn:scrum:person:dev"), entity_ref("urn:scrum:sprint:s")) { origin case_input; }
    }
    evaluate truth(sprint_cancelled(entity_ref("urn:scrum:sprint:s")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
