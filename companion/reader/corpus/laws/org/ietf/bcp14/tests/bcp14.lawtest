    expect evaluation_status == REQUIRES_JUDGMENT;
    expect issues_within(info);
    expect judgment_requests(1);
    expect judgment_request(valid_reason_to_ignore);

    evaluate positions();
    expect issues_within(info);
    expect position(FollowRecommendation, VIOLATED);
}

