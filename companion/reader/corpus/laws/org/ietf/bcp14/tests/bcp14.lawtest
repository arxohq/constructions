            origin case_input;
        }

        assert "assert-f3": keyword_written(entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow"), Must, AllCapitals) {
            origin case_input;
        }

        assert "assert-f4": behaviour_deviates(entity_ref("urn:case:impl:origin-server"), entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow")) {
            origin case_input;
        }
    }

    evaluate positions();
    expect issues_within(info);
    expect position(SatisfyAbsoluteRequirement, VIOLATED);

    evaluate truth(requirement_satisfied(entity_ref("urn:case:impl:origin-server"), entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow")));
    expect truth_status == FALSE_ONLY;
    expect issues_within(info);
}

