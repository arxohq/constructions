test "BCP14-19-NO-CONFORMANCE-CLAIM-NO-POSITION" {
    given {
        context {
            decision_time @2026-08-30T12:00:00Z;
            knowledge_time @2026-08-30T12:00:00Z;
            legal_time @2026-08-30;
            timezone "UTC";
        }

        assert "assert-f0": adopted_bcp14(entity_ref("urn:ietf:rfc:9110")) {
            origin case_input;
        }

        assert "assert-f1": stated_in(entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow"), entity_ref("urn:ietf:rfc:9110")) {
            origin case_input;
        }

        assert "assert-f2": keyword_written(entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow"), Must, AllCapitals) {
            origin case_input;
        }

        assert "assert-f3": behaviour_deviates(entity_ref("urn:case:impl:origin-server"), entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow")) {
            origin case_input;
        }
    }

    evaluate positions();
    expect issues_within(info);
}

test "BCP14-20-BEFORE-COMMENCEMENT-THE-REFERENCE-REFUSES-BY-NAME" {
    given {
        context {
            decision_time @1997-02-28T12:00:00Z;
            knowledge_time @1997-02-28T12:00:00Z;
            legal_time @1997-02-28;
            timezone "UTC";
        }

        assert "assert-f0": adopted_bcp14(entity_ref("urn:ietf:rfc:9110")) {
            origin case_input;
        }

        assert "assert-f1": stated_in(entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow"), entity_ref("urn:ietf:rfc:9110")) {
            origin case_input;
        }

        assert "assert-f2": claims_conformance(entity_ref("urn:case:impl:origin-server"), entity_ref("urn:ietf:rfc:9110")) {
            origin case_input;
        }

        assert "assert-f3": keyword_written(entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow"), Must, AllCapitals) {
            origin case_input;
        }

        assert "assert-f4": behaviour_conforms(entity_ref("urn:case:impl:origin-server"), entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow")) {
            origin case_input;
        }
    }

    evaluate positions();
    expect issues_within(info, SOURCE_RESOLUTION_FAILED);
    expect issue(SOURCE_RESOLUTION_FAILED);
}

test "BCP14-21-FIRST-DAY-OF-THE-NAMED-MONTH-IS-ACTIVE" {
    given {
        context {
            decision_time @1997-03-01T12:00:00Z;
            knowledge_time @1997-03-01T12:00:00Z;
            legal_time @1997-03-01;
            timezone "UTC";
        }

        assert "assert-f0": adopted_bcp14(entity_ref("urn:ietf:rfc:9110")) {
            origin case_input;
        }

        assert "assert-f1": stated_in(entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow"), entity_ref("urn:ietf:rfc:9110")) {
            origin case_input;
        }

        assert "assert-f2": claims_conformance(entity_ref("urn:case:impl:origin-server"), entity_ref("urn:ietf:rfc:9110")) {
            origin case_input;
        }

        assert "assert-f3": keyword_written(entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow"), Must, AllCapitals) {
            origin case_input;
        }

        assert "assert-f4": behaviour_conforms(entity_ref("urn:case:impl:origin-server"), entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow")) {
            origin case_input;
        }
    }

    evaluate positions();
    expect issues_within(info);
    expect position(SatisfyAbsoluteRequirement, ACTIVE);
}

test "BCP14-22-JUDGMENT-CHANNEL-INVISIBLE-THROUGH-NORM-HEADS" {
    given {
        context {
            decision_time @2026-08-30T12:00:00Z;
            knowledge_time @2026-08-30T12:00:00Z;
            legal_time @2026-08-30;
            timezone "UTC";
        }

        assert "assert-f0": adopted_bcp14(entity_ref("urn:ietf:rfc:9110")) {
            origin case_input;
        }

        assert "assert-f1": stated_in(entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow"), entity_ref("urn:ietf:rfc:9110")) {
            origin case_input;
        }

        assert "assert-f2": claims_conformance(entity_ref("urn:case:impl:origin-server"), entity_ref("urn:ietf:rfc:9110")) {
            origin case_input;
        }

        assert "assert-f3": keyword_written(entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow"), Should, AllCapitals) {
            origin case_input;
        }

        assert "assert-f4": behaviour_deviates(entity_ref("urn:case:impl:origin-server"), entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow")) {
            origin case_input;
        }

        assert "assert-f5": implications_understood_and_weighed(entity_ref("urn:case:impl:origin-server"), entity_ref("urn:ietf:rfc:9110#section-15.5.6-allow")) {
            origin case_input;
        }
    }

    evaluate positions();
    expect issues_within(info);
}
