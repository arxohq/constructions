language "law.core" version "0.2";
package openstax.chemistry_acids version "0.1.0";
namespace "urn:openstax:clir:chemistry-acids";

// Сцены пакета: единственный вывод словаря — амфипротность по абзацу 14.1
// («Species capable of either donating or accepting protons are called
// amphiprotic»), и обе его границы.
//
// ТРИ РАЗНЫХ ОТВЕТА, И ОНИ РАЗЛИЧИМЫ. TRUE_ONLY — обе роли установлены;
// FALSE_ONLY — одна установлена, вторая ОПРОВЕРГНУТА делом (`assert not …`);
// NEITHER — вторая просто не названа. Третий случай не есть отрицание, и
// сцены 05–07 показывают это тремя способами: молчание о донорности, молчание
// об акцепторности и молчание об обеих.

// --- Обе роли установлены: амфипротна ------------------------------------

test "urn:query:openstax-chem-acids-01-water-amphiprotic" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
        }
        assert "os01-q": species_in_question(entity_ref("urn:case:chem:h2o")) { origin case_input; }
        assert "os01-1": donates_proton(entity_ref("urn:case:chem:h2o")) { origin case_input; }
        assert "os01-2": accepts_proton(entity_ref("urn:case:chem:h2o")) { origin case_input; }
    }
    evaluate truth(amphiprotic(entity_ref("urn:case:chem:h2o")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(AmphiproticDonatesAndAccepts);
}

// Второй пример того же абзаца: гидрокарбонат-ион реагирует с водой и как
// кислота, и как основание.
test "urn:query:openstax-chem-acids-02-bicarbonate-amphiprotic" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
        }
        assert "os02-q": species_in_question(entity_ref("urn:case:chem:hco3")) { origin case_input; }
        assert "os02-1": donates_proton(entity_ref("urn:case:chem:hco3")) { origin case_input; }
        assert "os02-2": accepts_proton(entity_ref("urn:case:chem:hco3")) { origin case_input; }
    }
    evaluate truth(amphiprotic(entity_ref("urn:case:chem:hco3")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(AmphiproticDonatesAndAccepts);
}

// --- Одна роль опровергнута: НЕ амфипротна (FALSE_ONLY) -------------------

test "urn:query:openstax-chem-acids-03-ammonia-not-amphiprotic" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
        }
        assert "os03-q": species_in_question(entity_ref("urn:case:chem:nh3")) { origin case_input; }
        assert "os03-1": accepts_proton(entity_ref("urn:case:chem:nh3")) { origin case_input; }
        assert "os03-2": not donates_proton(entity_ref("urn:case:chem:nh3")) { origin case_input; }
    }
    evaluate truth(amphiprotic(entity_ref("urn:case:chem:nh3")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(NotAmphiproticWithoutDonation);
}

