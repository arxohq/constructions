        assert "os06-1": donates_proton(entity_ref("urn:case:chem:hno3")) { origin case_input; }
    }
    evaluate truth(amphiprotic(entity_ref("urn:case:chem:hno3")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Ни одной роли не названо: связывающей посылки нет ни у одного правила, и
// изложение молчит — как и должно. Это НЕ FALSE_ONLY: «о частице ничего не
// известно» и «частица не амфипротна» — разные ответы.
test "urn:query:openstax-chem-acids-07-silence-on-both" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
        }
        assert "os07-q": species_in_question(entity_ref("urn:case:chem:ar")) { origin case_input; }
    }
    evaluate truth(amphiprotic(entity_ref("urn:case:chem:ar")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Обе роли ОПРОВЕРГНУТЫ, и ответ всё равно NEITHER: у обоих отрицательных
// правил связывающая посылка позитивна (§190), и ни одно не срабатывает.
// Граница модели названа сценой, а не спрятана.
test "urn:query:openstax-chem-acids-08-both-refuted-still-neither" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
        }
        assert "os08-q": species_in_question(entity_ref("urn:case:chem:ch4")) { origin case_input; }
        assert "os08-1": not donates_proton(entity_ref("urn:case:chem:ch4")) { origin case_input; }
        assert "os08-2": not accepts_proton(entity_ref("urn:case:chem:ch4")) { origin case_input; }
    }
    evaluate truth(amphiprotic(entity_ref("urn:case:chem:ch4")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// --- Пары сопряжённых частиц: гидроксоний и гидроксид --------------------

test "urn:query:openstax-chem-acids-09-hydronium-not-amphiprotic" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
