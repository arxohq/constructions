        assert "os04-q": species_in_question(entity_ref("urn:case:chem:hcl")) { origin case_input; }
        assert "os04-1": donates_proton(entity_ref("urn:case:chem:hcl")) { origin case_input; }
        assert "os04-2": not accepts_proton(entity_ref("urn:case:chem:hcl")) { origin case_input; }
    }
    evaluate truth(amphiprotic(entity_ref("urn:case:chem:hcl")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(NotAmphiproticWithoutAcceptance);
}

// --- Молчание дела — не отрицание ----------------------------------------

test "urn:query:openstax-chem-acids-05-silence-on-donation-why-not" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
        }
        assert "os05-q": species_in_question(entity_ref("urn:case:chem:so4")) { origin case_input; }
        assert "os05-1": accepts_proton(entity_ref("urn:case:chem:so4")) { origin case_input; }
    }
    evaluate why_not(amphiprotic(entity_ref("urn:case:chem:so4")));
    expect truth_status == NEITHER;
    expect blocked_by("AmphiproticDonatesAndAccepts");
}

