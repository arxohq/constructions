            legal_time @2026-09-06;
            timezone "UTC";
        }
        assert "os09-q": species_in_question(entity_ref("urn:case:chem:h3o")) { origin case_input; }
        assert "os09-1": donates_proton(entity_ref("urn:case:chem:h3o")) { origin case_input; }
        assert "os09-2": not accepts_proton(entity_ref("urn:case:chem:h3o")) { origin case_input; }
        assert "os09-3": conjugate_acid_of(entity_ref("urn:case:chem:h3o"), entity_ref("urn:case:chem:h2o")) { origin case_input; }
    }
    evaluate truth(amphiprotic(entity_ref("urn:case:chem:h3o")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(NotAmphiproticWithoutAcceptance);
}

