language "law.core" version "0.2";
package myco.opredelitel version "0.1.0";
namespace "urn:myco:clir:opredelitel";

test "urn:query:myco-t01-no-spore-print" {
    given {
        context { decision_time @2026-08-31T12:00:00Z; knowledge_time @2026-08-31T12:00:00Z; legal_time @2026-08-31; timezone "Europe/Moscow"; }
        assert "myco-t01-1": specimen(entity_ref("urn:case:myco:t01")) { origin case_input; }
        assert "myco-t01-2": hymenophore(entity_ref("urn:case:myco:t01"), Gills) { origin case_input; }
        assert "myco-t01-3": ring(entity_ref("urn:case:myco:t01"), Present) { origin case_input; }
        assert "myco-t01-4": volva(entity_ref("urn:case:myco:t01"), Absent) { origin case_input; }
        assert "myco-t01-5": gill_color(entity_ref("urn:case:myco:t01"), Pink) { origin case_input; }
        assert "myco-t01-6": latex(entity_ref("urn:case:myco:t01"), Absent) { origin case_input; }
        assert "myco-t01-7": flesh_change(entity_ref("urn:case:myco:t01"), Pinking) { origin case_input; }
    }
    evaluate truth(identified_as(entity_ref("urn:case:myco:t01"), AgaricusCampestris));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
}
