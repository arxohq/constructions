language "law.core" version "0.2";
package grc.eukleides.pythagoras version "0.1.0";
namespace "urn:grc:eukleides:clir:pythagoras";

// Машинный свидетель остроугольности: z3 подбирал стороны под КОНЪЮНКЦИЮ
// трёх неравенств сразу (18 > 1, 10 > 9, 10 > 9) плюс гейт I.20 и вышел на
// равнобедренный 3-3-1. Задача обратная свидетелям тупоугольности: там
// довольно одного нарушенного неравенства, здесь обязаны выполниться все
// три — `--rule OxygonionKataPasasTasGonias`.
test "urn:query:eucl-smt-acute-331" {
    given {
        context {
            decision_time @0001-01-01T12:00:00Z;
            knowledge_time @0001-01-01T12:00:00Z;
            legal_time @0001-01-01;
            timezone "UTC";
        }
        assert "eucl-t18-1": grc.euclid.stoicheia_i::pleurai_trigonou(entity_ref("urn:case:eucl:trigonon"), 3, 3, 1) {
            origin case_input;
        }
    }
    evaluate truth(grc.euclid.stoicheia_i::oxygonion(entity_ref("urn:case:eucl:trigonon")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
