language "law.core" version "0.2";
package grc.eukleides.pythagoras version "0.1.0";
namespace "urn:grc:eukleides:clir:pythagoras";

// Сценарии перенесены из прежнего Python-раннера семейства `pythagoras`.
// Заголовки — прежние ID сценариев (scenario-manifest); ожидания
// выведены из ПРЕЖНИХ проверок, а не из ответов движка.

test "EUCL-01-TRIANGLE-234" {
    given {
        context {
            decision_time @2026-08-26T12:00:00+05:00;
            knowledge_time @2026-08-26T12:00:00+05:00;
            legal_time @2026-08-31;
            timezone "Asia/Qyzylorda";
        }

        assert "assert-sides": grc.euclid.stoicheia_i::pleurai_trigonou(entity_ref("urn:case:eucl:trigonon"), 2, 3, 4) {
            origin case_input;
        }
    }

    evaluate truth(grc.euclid.stoicheia_i::trigonon_synistatai(entity_ref("urn:case:eucl:trigonon")));
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
}

test "EUCL-02-DEGENERATE-123" {
    given {

        assert "assert-sides": grc.euclid.stoicheia_i::pleurai_trigonou(entity_ref("urn:case:eucl:trigonon"), 1, 2, 3) {
            origin case_input;
        }
    }

    evaluate truth(grc.euclid.stoicheia_i::oude_trigonon(entity_ref("urn:case:eucl:trigonon")));
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);

    evaluate truth(grc.euclid.stoicheia_i::trigonon_synistatai(entity_ref("urn:case:eucl:trigonon")));
    expect truth_status == NEITHER;
    expect issues_within(info);
}

