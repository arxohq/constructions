language "law.core" version "0.2";
package grc.eukleides.pythagoras version "0.1.0";
namespace "urn:grc:eukleides:clir:pythagoras";

// Контрапозиция I.47 машинным свидетелем: НЕ-тройка. z3 подбирал стороны
// под конъюнкцию трёх неравенств сразу (49+1 != 49, 1+49 != 49,
// 49+49 != 1) плюс гейт существования I.20 (7+1 > 7, 1+7 > 7, 7+7 > 1) —
// и вышел на равнобедренный 7-1-7. Задача обратная предыдущим двум:
// там решатель искал равенство, здесь — его невозможность ни при одной
// из трёх позиций угла.
test "urn:query:eucl-smt-717" {
    given {
        context {
            decision_time @0001-01-01T12:00:00Z;
            knowledge_time @0001-01-01T12:00:00Z;
            legal_time @0001-01-01;
            timezone "UTC";
        }
        assert "eucl-t08-1": grc.euclid.stoicheia_i::pleurai_trigonou(entity_ref("urn:case:eucl:trigonon"), 7, 1, 7) {
            origin case_input;
        }
    }
    evaluate truth(grc.euclid.stoicheia_i::ouk_orthogonion(entity_ref("urn:case:eucl:trigonon")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
