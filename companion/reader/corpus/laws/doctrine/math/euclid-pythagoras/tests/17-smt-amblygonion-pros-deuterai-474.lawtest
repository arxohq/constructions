language "law.core" version "0.2";
package grc.eukleides.pythagoras version "0.1.0";
namespace "urn:grc:eukleides:clir:pythagoras";

// Машинный свидетель третьей позиции — угол против ВТОРОЙ стороны
// (a*a + c*c < b*b: 16 + 16 = 32 меньше 49). Равнобедренный тупоугольный,
// 4 + 4 больше 7 на единицу: `--rule AmblygonionProsDeuterai`. Вместе с 15
// и 16 закрывает все три правила II.12 машинными свидетелями — конвенции
// «сторона против тупого угла последняя» у пакета нет.
test "urn:query:eucl-smt-obtuse-474" {
    given {
        context {
            decision_time @0001-01-01T12:00:00Z;
            knowledge_time @0001-01-01T12:00:00Z;
            legal_time @0001-01-01;
            timezone "UTC";
        }
        assert "eucl-t17-1": grc.euclid.stoicheia_i::pleurai_trigonou(entity_ref("urn:case:eucl:trigonon"), 4, 7, 4) {
            origin case_input;
        }
    }
    evaluate truth(grc.euclid.stoicheia_i::amblygonion(entity_ref("urn:case:eucl:trigonon")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
