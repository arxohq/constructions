language "law.core" version "0.2";
package grc.eukleides.pythagoras version "0.1.0";
namespace "urn:grc:eukleides:clir:pythagoras";

// Сторож I.47: дело заявило прямой угол между первыми двумя сторонами
// тройки 2-3-4, а 4 + 9 != 16 — противоречие входа обязано звучать, а не
// сосуществовать молча. Согласная пара (3-4-5 с тем же заявлением) молчит —
// сцена EUCL-13N семейства.
test "urn:query:eucl-enantiosis" {
    given {
        context {
            decision_time @0001-01-01T12:00:00Z;
            knowledge_time @0001-01-01T12:00:00Z;
            legal_time @0001-01-01;
            timezone "UTC";
        }
        assert "eucl-t04-1": grc.euclid.stoicheia_i::pleurai_trigonou(entity_ref("urn:case:eucl:trigonon"), 2, 3, 4) {
            origin case_input;
        }
        assert "eucl-t04-2": dedilotai_orthe_gonia(entity_ref("urn:case:eucl:trigonon")) {
            origin case_input;
        }
    }
    evaluate truth(enantiosis_gonias_kai_pleuron(entity_ref("urn:case:eucl:trigonon")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
