language "law.core" version "0.2";
package grc.eukleides.pythagoras version "0.1.0";
namespace "urn:grc:eukleides:clir:pythagoras";

// Машинный свидетель второй позиции тупого угла — против ПЕРВОЙ стороны
// (b*b + c*c < a*a: 16 + 4 = 20 меньше 25). Тройка 5-4-2 едва составляет
// треугольник (4 + 2 больше 5 на единицу), и решатель вышел на её край сам:
// `--rule AmblygonionProsProtei`.
test "urn:query:eucl-smt-obtuse-542" {
    given {
        context {
            decision_time @0001-01-01T12:00:00Z;
            knowledge_time @0001-01-01T12:00:00Z;
            legal_time @0001-01-01;
            timezone "UTC";
        }
        assert "eucl-t16-1": grc.euclid.stoicheia_i::pleurai_trigonou(entity_ref("urn:case:eucl:trigonon"), 5, 4, 2) {
            origin case_input;
        }
    }
    evaluate truth(grc.euclid.stoicheia_i::amblygonion(entity_ref("urn:case:eucl:trigonon")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
