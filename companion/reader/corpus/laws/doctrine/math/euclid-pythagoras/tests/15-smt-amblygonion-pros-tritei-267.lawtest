language "law.core" version "0.2";
package grc.eukleides.pythagoras version "0.1.0";
namespace "urn:grc:eukleides:clir:pythagoras";

// МАШИННЫЙ СВИДЕТЕЛЬ. Стороны подобрал z3 под гард правила
// AmblygonionProsTritei (a*a + b*b < c*c) вместе с гейтом существования
// I.20 — 4 + 36 = 40 меньше 49, и при этом 2 + 6 больше 7. Модель
// воспроизводится:
//
//   python3 verify/ci/tools/smt_witness.py \
//       --package corpus/clir/grc-euclid-pythagoras.lawir.json \
//       --rule AmblygonionProsTritei
test "urn:query:eucl-smt-obtuse-267" {
    given {
        context {
            decision_time @0001-01-01T12:00:00Z;
            knowledge_time @0001-01-01T12:00:00Z;
            legal_time @0001-01-01;
            timezone "UTC";
        }
        assert "eucl-t15-1": grc.euclid.stoicheia_i::pleurai_trigonou(entity_ref("urn:case:eucl:trigonon"), 2, 6, 7) {
            origin case_input;
        }
    }
    evaluate truth(grc.euclid.stoicheia_i::amblygonion(entity_ref("urn:case:eucl:trigonon")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
