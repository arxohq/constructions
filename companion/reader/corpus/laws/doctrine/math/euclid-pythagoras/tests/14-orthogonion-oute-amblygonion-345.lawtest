language "law.core" version "0.2";
package grc.eukleides.pythagoras version "0.1.0";
namespace "urn:grc:eukleides:clir:pythagoras";

// ПОПАРНЫЙ ИНВАРИАНТ, УВИДЕННЫЙ НА ДЕЛЕ. Констрейнты §93.1 исполнением не
// читаются вовсе (evaluate() их не считает — свойство ядра 0.1), поэтому
// «прямоугольный не бывает тупоугольным» на деле проверяется единственным
// способом: спросить второй род и получить молчание. Египетская тройка
// 3-4-5 прямоугольна (тест 01) и обязана быть НЕ тупоугольной.
test "urn:query:eucl-right-not-obtuse-345" {
    given {
        context {
            decision_time @0001-01-01T12:00:00Z;
            knowledge_time @0001-01-01T12:00:00Z;
            legal_time @0001-01-01;
            timezone "UTC";
        }
        assert "eucl-t14-1": grc.euclid.stoicheia_i::pleurai_trigonou(entity_ref("urn:case:eucl:trigonon"), 3, 4, 5) {
            origin case_input;
        }
    }
    evaluate truth(grc.euclid.stoicheia_i::amblygonion(entity_ref("urn:case:eucl:trigonon")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
