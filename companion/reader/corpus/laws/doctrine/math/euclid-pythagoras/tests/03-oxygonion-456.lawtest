language "law.core" version "0.2";
package grc.eukleides.pythagoras version "0.1.0";
namespace "urn:grc:eukleides:clir:pythagoras";

// Контрапозиция I.47: у тройки 4-5-6 пифагорово соотношение не выполнено
// ни при одной позиции угла (41≠36, 61≠16, 52≠25) — треугольник не
// прямоугольный, и это ВЫВОД, а не молчание признака.
test "urn:query:eucl-456" {
    given {
        context {
            decision_time @0001-01-01T12:00:00Z;
            knowledge_time @0001-01-01T12:00:00Z;
            legal_time @0001-01-01;
            timezone "UTC";
        }
        assert "eucl-t03-1": grc.euclid.stoicheia_i::pleurai_trigonou(entity_ref("urn:case:eucl:trigonon"), 4, 5, 6) {
            origin case_input;
        }
    }
    evaluate truth(grc.euclid.stoicheia_i::ouk_orthogonion(entity_ref("urn:case:eucl:trigonon")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
