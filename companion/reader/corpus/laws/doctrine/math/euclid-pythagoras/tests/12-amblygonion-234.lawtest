language "law.core" version "0.2";
package grc.eukleides.pythagoras version "0.1.0";
namespace "urn:grc:eukleides:clir:pythagoras";

// II.12 на наименьшем тупоугольном в целых: 4 + 9 = 13 меньше 16, значит
// квадрат третьей стороны БОЛЬШЕ суммы квадратов двух других — угол против
// неё тупой. Та же тройка 2-3-4 стоит в тесте 04 сторожем заявленного угла:
// одно дело, два разных вопроса.
test "urn:query:eucl-obtuse-234" {
    given {
        context {
            decision_time @0001-01-01T12:00:00Z;
            knowledge_time @0001-01-01T12:00:00Z;
            legal_time @0001-01-01;
            timezone "UTC";
        }
        assert "eucl-t12-1": grc.euclid.stoicheia_i::pleurai_trigonou(entity_ref("urn:case:eucl:trigonon"), 2, 3, 4) {
            origin case_input;
        }
    }
    evaluate truth(grc.euclid.stoicheia_i::amblygonion(entity_ref("urn:case:eucl:trigonon")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
