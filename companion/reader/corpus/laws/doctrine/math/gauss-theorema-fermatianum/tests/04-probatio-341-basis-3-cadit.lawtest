language "law.core" version "0.2";
package la.gauss.theorema_fermatianum version "0.1.0";
namespace "urn:la:gauss:clir:theorema-fermatianum";

// То же число по основанию 3: 3^340 mod 341 = 56, не единица — тест
// ПРОВАЛЕН. Два основания ловят 341 там, где одного мало.
// След вычислен возведением в степень по модулю и ПРОВЕРЯЕТСЯ движком
// звено за звеном (артикул 46); воспроизводится строкой
//   python3 -c "n,a=341,3;[print(e,pow(a,e,n)) for e in [1, 2, 4, 5, 10, 20, 21, 42, 84, 85, 170, 340]]"

test "urn:query:04-probatio-341-basis-3-cadit" {
    given {
        context {
            decision_time @0001-01-01T12:00:00Z;
            knowledge_time @0001-01-01T12:00:00Z;
            legal_time @0001-01-01;
            timezone "UTC";
        }
        assert "flt-propositum": propositum(entity_ref("urn:case:flt:probatio"), 341, 3) { origin case_input; }
        assert "flt-vestigium": vestigium(entity_ref("urn:case:flt:probatio"), 340) { origin case_input; }
        assert "flt-residuum-0": residuum(entity_ref("urn:case:flt:probatio"), 1, 3) { origin case_input; }
        assert "flt-residuum-1": residuum(entity_ref("urn:case:flt:probatio"), 2, 9) { origin case_input; }
        assert "flt-residuum-2": residuum(entity_ref("urn:case:flt:probatio"), 4, 81) { origin case_input; }
        assert "flt-residuum-3": residuum(entity_ref("urn:case:flt:probatio"), 5, 243) { origin case_input; }
        assert "flt-residuum-4": residuum(entity_ref("urn:case:flt:probatio"), 10, 56) { origin case_input; }
        assert "flt-residuum-5": residuum(entity_ref("urn:case:flt:probatio"), 20, 67) { origin case_input; }
        assert "flt-residuum-6": residuum(entity_ref("urn:case:flt:probatio"), 21, 201) { origin case_input; }
        assert "flt-residuum-7": residuum(entity_ref("urn:case:flt:probatio"), 42, 163) { origin case_input; }
        assert "flt-residuum-8": residuum(entity_ref("urn:case:flt:probatio"), 84, 312) { origin case_input; }
        assert "flt-residuum-9": residuum(entity_ref("urn:case:flt:probatio"), 85, 254) { origin case_input; }
        assert "flt-residuum-10": residuum(entity_ref("urn:case:flt:probatio"), 170, 67) { origin case_input; }
        assert "flt-residuum-11": residuum(entity_ref("urn:case:flt:probatio"), 340, 56) { origin case_input; }
    }
    evaluate truth(probatio_fermatiana_transacta(entity_ref("urn:case:flt:probatio")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
