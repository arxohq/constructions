        assert "assert-residuum-2": residuum(entity_ref("urn:case:flt:probatio"), 3, 8) {
            origin case_input;
        }

        assert "assert-residuum-3": residuum(entity_ref("urn:case:flt:probatio"), 6, 12) {
            origin case_input;
        }

        assert "assert-residuum-4": residuum(entity_ref("urn:case:flt:probatio"), 12, 1) {
            origin case_input;
        }

        assert "assert-ordo": ordo(entity_ref("urn:case:flt:probatio"), 5) {
            origin case_input;
        }
    }

    evaluate truth(ordo_absurdus(entity_ref("urn:case:flt:probatio")));
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
}

test "FLT-25-ORDO-PROBATUS" {
    given {
        context {
            decision_time @2026-08-26T12:00:00+05:00;
            knowledge_time @2026-08-26T12:00:00+05:00;
            legal_time @0001-01-01;
            timezone "Asia/Qyzylorda";
        }

        assert "assert-propositum": propositum(entity_ref("urn:case:flt:probatio"), 13, 3) {
