language "law.core" version "0.2";
package la.gauss.theorema_fermatianum version "0.1.0";
namespace "urn:la:gauss:clir:theorema-fermatianum";

// Сценарии перенесены из прежнего Python-раннера семейства `fermat`.
// Заголовки — прежние ID сценариев (scenario-manifest); ожидания
// выведены из ПРЕЖНИХ проверок, а не из ответов движка.

test "FLT-01-PROBATIO-7-BASIS-2" {
    given {
        context {
            decision_time @2026-08-26T12:00:00+05:00;
            knowledge_time @2026-08-26T12:00:00+05:00;
            legal_time @0001-01-01;
            timezone "Asia/Qyzylorda";
        }

        assert "assert-propositum": propositum(entity_ref("urn:case:flt:probatio"), 7, 2) {
            origin case_input;
        }

        assert "assert-vestigium": vestigium(entity_ref("urn:case:flt:probatio"), 6) {
            origin case_input;
        }

        assert "assert-residuum-0": residuum(entity_ref("urn:case:flt:probatio"), 1, 2) {
            origin case_input;
        }

        assert "assert-residuum-1": residuum(entity_ref("urn:case:flt:probatio"), 2, 4) {
            origin case_input;
        }

        assert "assert-residuum-2": residuum(entity_ref("urn:case:flt:probatio"), 3, 1) {
            origin case_input;
        }

        assert "assert-residuum-3": residuum(entity_ref("urn:case:flt:probatio"), 6, 1) {
            origin case_input;
        }
    }

    evaluate truth(probatio_fermatiana_transacta(entity_ref("urn:case:flt:probatio")));
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
}

