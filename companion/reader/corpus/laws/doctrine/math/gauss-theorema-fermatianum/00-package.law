// Малая теорема Ферма: «Disquisitiones arithmeticae» Гаусса, sectio tertia
// «De residuis potestatum», артикулы 45—50. Второй акт корпуса, чей предмет —
// математическая теорема с закреплённым источником, и ПЕРВЫЙ, у которого
// поражаемый слой несёт основную нагрузку.
//
// ЗАЧЕМ ЭТОТ АКТ ЗАВЕДЁН — ЭТО АКТ-ТАРАН. Он бьёт в единственный оставшийся
// «объявленный и неконструируемый» из перечня §58: `+ - * / mod min max abs
// pow`. Пять первых — операторы, `min`/`max`/`abs` — термы std §259, а `pow`
// не существует нигде ниже перечня: ни продукции в grammar.ebnf (на
// множительном уровне стои́т только `* / mod`), ни лексемы, ни таблицы видов,
// ни семантики. Errata E-0062, закрывшая `mod`, назвала пробел смежным и
// оставила его СОЗНАТЕЛЬНО: «у `pow` нет ни одного свидетеля в корпусе, а
// вводить поверхность без свидетеля — ровно то, за что E-0037 упрекала
// перечень §258». Свидетель — этот акт. Замер тарана (что именно отвечает
// компилятор на каждую из трёх попыток записи степени) и черновик errata —
// audit.ru.md §3—§4; черновик ПРИЛОЖЕН, а не проведён: решение владельца.
//
// ЧТО ФОРМАЛИЗУЕТСЯ И ЧТО НЕТ. Формализуются УТВЕРЖДЕНИЯ артикулов как
// исполнимые правила над конкретным испытанием: движок отвечает на дела
// («след возведения 2 по модулю 7 — верен? тест Ферма пройден?»), а не
// доказывает теорему. ДОКАЗАТЕЛЬСТВА Гаусса (разбиение ряда 1…p−1 на классы
// (A), (B), (C)… в артикуле 49) закреплены байтами и выводом не выражаются:
// рассуждение о произвольном простом модуле — не о деле. Универсальную
// общность держат не правила, а инварианты §93.1, атака решателем (audit §5)
// и Lean-нога. То же разделение труда, что у `grc.eukleides.pythagoras`.
//
// СТЕПЕНЬ НЕВЫРАЗИМА ТЕРМОМ — И ПОЭТОМУ ВЫРАЖЕНА ЦЕПЬЮ. `a^(n−1) mod n == 1`
// одним гардом не пишется (см. таран выше). Но артикул 46 Гаусса — и есть
// правило ШАГА: «Scilicet si $a^{t} \equiv 1$, erit $a^{t+1} \equiv a$». Дело
// приносит СЛЕД возведения — последовательность `residuum(pr, e, r)`, — а
// движок проверяет каждое звено: `r(e+1) == (r(e) * a) mod n`. Доказательство
// приезжает делом, право его проверяет. Цена идиома названа прямо: след
// обязан быть ПОЛНЫМ, потому что дыра в цепочке молчит сама по себе, — её
// делают громкой два сторожа, `vestigium_falsum` (звено не сходится) и
// `vestigium_ruptum` (цепь не дошла до объявленной длины). После errata `pow`
// цепь станет СВОДИМОЙ к одному гарду, и обе записи обязаны совпасть на тех
// же делах; какие правила перепишутся — сказано в черновике errata.
//
// ЦЕЛЫЕ ЧИСЛА И ОСТАТОК. Модуль, основание, показатели и остатки — Integer.
// Остаток берётся оператором `mod` §58 (errata E-0062), евклидовым: `0 <= r <
// |b|` при любых знаках, поэтому «остаток» здесь всегда канонический
// представитель класса вычетов, как того и требует «residuum minimum
// positivum» артикула 49.
//
// ЧТО В ПАКЕТЕ ДОКТРИНАЛЬНО, А ЧТО ВЗЯТО У ГАУССА — НАЗВАНО ВСЛУХ. Гаусс
// доказывает ОДНУ импликацию: p простое и не делит a ⟹ a^(p−1) ≡ 1. ОБРАТНОЙ
// у него нет и быть не может — она ложна (341 = 11·31 проходит тест по
// основанию 2). Пакет тем не менее выводит из пройденного теста презумпцию
// простоты, и это ДОКТРИНАЛЬНЫЙ ШАГ, а не чтение источника: так тест Ферма
// применяется на деле — как поражаемое основание, снимаемое предъявленным
// делителем. Шаг несёт поражаемый слой (`presumption` + `unless`), а не
// строгое правило, ровно поэтому: строгим он был бы ложью о числе 341.
// Разбор — 02-articuli-49-50.law.
//
// РАЗРЕЗ МОДУЛЕЙ ЗЕРКАЛИТ АРТИКУЛЫ источника (docs/PACKAGE-LAYOUT.ru.md,
// «зеркалить структурированный источник»):
//
//   01-articuli-45-48.law  45—48 — существование показателя, правило шага,
//                          компендий, наименьший показатель: машинерия следа
//   02-articuli-49-50.law  49—50 — теорема о порядке, теорема Ферма,
//                          презумпция простоты и её дефитеры
//
// ГРАНИЦЫ СРЕЗА, НАЗВАННЫЕ ПОИМЁННО. Вне охвата: артикулы 1—44 и 51—366
// «Disquisitiones» целиком (сравнения первой степени, первообразные корни,
// формы, деление круга); из закреплённых артикулов — доказательства и
// историческая справка артикула 50 (Ферма 1679, Эйлер, Лямберт, спор
// Мопертюи и Кёнига в сноске): справка есть провенанс утверждения, а не
// норма. Дата принятия не объявлена — у сочинения её нет.

language "law.core" version "0.2";
package la.gauss.theorema_fermatianum version "0.1.0";
namespace "urn:la:gauss:clir:theorema-fermatianum";

// Испытание дела — носитель вопроса: один модуль, одно основание, один след
// возведения. Числа — отношениями, не полями: они эмпирика дела, а не
// тождество сущности (§36).
entity Probatio {
    label la official "probatio";
    label ru unofficial "испытание — модуль, основание и предъявленный след возведения, о которых задан вопрос дела";
}

// Что предъявлено испытанию: модуль и основание прогрессии. Ключ по
// испытанию: у одного дела одна пара, две — KEY_CONFLICT §196, а не
// молчаливый выбор.
relation propositum(pr: Probatio, modulus: Integer, basis: Integer) kind empirical {
    key(pr);
    label la unofficial "progressio geometrica secundum modulum p ad basim a";
    label ru unofficial "модуль и основание геометрической прогрессии, предъявленные испытанию (артикул 45: «In omni progressione geometrica … secundum modulum p ad a primum»)";
}

// Звено следа: остаток основания в степени показателя по модулю испытания.
// ЭМПИРИКА: так сказало дело — движок это НЕ вычисляет (степени в языке нет),
// он это ПРОВЕРЯЕТ правилом шага артикула 46.
relation residuum(pr: Probatio, exponens: Integer, valor: Integer) kind empirical {
    label la unofficial "residuum minimum potestatis exponentis dati";
    label ru unofficial "звено следа: дело заявляет, что основание в степени exponens сравнимо с valor по модулю испытания; движок звено не вычисляет, а проверяет";
}

// Длина следа, объявленная делом: след предъявлен непрерывно от показателя 1
// до этого показателя. Без объявления дыра в следе молчит — цепь просто не
// доходит, и это неотличимо от «след короче».
relation vestigium(pr: Probatio, longitudo: Integer) kind empirical {
    key(pr);
    label la unofficial "vestigium potestatum ab exponente uno usque ad longitudinem datam";
    label ru unofficial "дело объявляет, что след предъявлен непрерывно от показателя 1 до этой длины; сверку объявления с самим следом ведёт сторож vestigium_ruptum";
}

// Показатель, объявленный делом НАИМЕНЬШИМ из дающих единицу («infima
// potestas unitati congrua», артикул 48). Заявление проверяется тремя
// сторожами артикулов 45 и 48, а не принимается на веру.
relation ordo(pr: Probatio, exponens: Integer) kind empirical {
    key(pr);
    label la unofficial "infima potestas unitati congrua";
    label ru unofficial "показатель, объявленный делом наименьшим из дающих единицу (артикул 48: «Quando $a^{t}$ est infima potestas unitati congrua»)";
}

// Показатель, о котором дело спрашивает остаток (артикул 47 — компендий:
// остаток сколь угодно большой степени берётся через остаток показателя по
// порядку). Это вопрос дела, а не звено следа.
relation quaesitum(pr: Probatio, exponens: Integer) kind empirical {
    key(pr);
    label la unofficial "potestas quantumvis magno exponente affecta de qua quaeritur";
    label ru unofficial "показатель, об остатке которого спрашивает дело (артикул 47: «compendium potestatum quantumvis magno exponente affectarum residua expedite inveniendi»)";
}

// Делитель, ПРЕДЪЯВЛЕННЫЙ против презумпции простоты. Эмпирика: делитель
// приносит дело, а не ищет движок, — перебор делителей неограничен, и
// выводить из него простоту значило бы соврать о вычислимости.
relation divisor_allatus(pr: Probatio, divisor: Integer) kind empirical {
    label la unofficial "divisor allatus qui modulum metitur";
    label ru unofficial "делитель, предъявленный делом против презумпции простоты; проверку самого делителя ведёт правило, а не доверие";
}

// Цепь проверена непрерывно от показателя 1 до этого показателя: каждое
// звено сошлось с предыдущим по правилу шага артикула 46.
relation catena(pr: Probatio, exponens: Integer) kind derived {
    label la unofficial "catena potestatum ad exponentem usque probata";
    label ru unofficial "след проверен непрерывно от показателя 1 до этого показателя — каждое звено сошлось по правилу шага (артикул 46)";
}

// Громкая граница следа: звено не сходится с предыдущим. Позитивный предикат
// сознательно — негативная голова строгого правила есть мёртвая норма.
relation vestigium_falsum(pr: Probatio) kind derived {
    label la unofficial "vestigium falsum: potestas cum praecedente non congruit";
    label ru unofficial "след подделан — какое-то звено не сходится с предыдущим по правилу шага артикула 46 либо первое звено не равно остатку самого основания";
}

// Громкая граница следа: цепь не дошла до объявленной длины. Дыра в
// показателях и оборванное звено дают ОДИН этот вывод, и это осознанно:
// сторож отвечает на вопрос «объявленному следу можно верить?», а какое
// именно звено виновато, называет vestigium_falsum.
relation vestigium_ruptum(pr: Probatio) kind derived {
    label la unofficial "vestigium ruptum: catena ad longitudinem declaratam non pervenit";
    label ru unofficial "цепь не дошла до объявленной делом длины следа — дыра в показателях либо оборванное звено; какое звено виновато, называет vestigium_falsum";
}

// Громкая граница заявления о наименьшем показателе: объявленный порядок
// противоречит самому следу либо артикулу 45.
relation ordo_absurdus(pr: Probatio) kind derived {
    label la unofficial "ordo absurdus: exponens declaratus sibi ipsi repugnat";
    label ru unofficial "объявленный наименьшим показатель противоречит следу: он не меньше модуля (артикул 45), либо единица встречается раньше него, либо он не делит показатель с единицей (артикул 48)";
}

// Тест Ферма пройден: цепь проверена до показателя p−1, и там единица, а
// модуль основания не делит (артикул 50).
relation probatio_fermatiana_transacta(pr: Probatio) kind derived {
    label la unofficial "probatio Fermatiana transacta: potestas p-1 unitati congrua";
    label ru unofficial "тест Ферма пройден — проверенная цепь дошла до показателя на единицу меньше модуля, и остаток там единица (артикул 50)";
}

// Остаток запрошенной степени, найденный компендием артикула 47.
relation residuum_quaesiti(pr: Probatio, exponens: Integer, valor: Integer) kind derived {
    label la unofficial "residuum potestatis quaesitae per compendium inventum";
    label ru unofficial "остаток запрошенной степени, найденный компендием артикула 47: показатель берётся по модулю порядка, и остаток читается из уже проверенного следа";
}

// Предъявленный делитель ПРОВЕРЕН правилом: он больше единицы, меньше модуля
// и модуль на него делится.
relation divisor_probatus(pr: Probatio, divisor: Integer) kind derived {
    label la unofficial "divisor probatus: modulum revera metitur";
    label ru unofficial "предъявленный делитель проверен: больше единицы, меньше модуля, и модуль на него делится без остатка";
}

// Объявленный порядок ПРОВЕРЕН следом: цепь дошла до него и остаток там
// единица. Наименьшим он этим не объявляется — леастность стерегут сторожа
// артикулов 45 и 48 громко, а рассуждению артикула 49 она не нужна.
relation ordo_probatus(pr: Probatio, exponens: Integer) kind derived {
    label la unofficial "ordo probatus: potestas unitati congrua vestigio confirmata";
    label ru unofficial "объявленный порядок проверен самим следом: цепь дошла до него и остаток там единица; наименьшим он этим не объявляется";
}

// Барьер поражения: модуль составной. Производители — ТОЛЬКО строгие
// правила (канон страты поражаемого слоя: у барьера с поражаемым
// производителем unless уезжает рангом выше презумпции, и ответ становится
// BOTH вместо FALSE_ONLY).
relation compositus(modulus: Integer) kind derived {
    label la unofficial "numerus compositus: divisorem habet";
    label ru unofficial "модуль составной — у него предъявлен и проверен собственный делитель; иных оснований составности пакет не выводит (разбор отвергнутого обращения артикула 49 — в audit §4)";
}

// Носитель нарушения теоремы Ферма для атаки решателем: основание, у
// которого фиксированная степень не даёт единицы при простом модуле. Норма
// нарушения, а не норма права: её отсутствия и требует инвариант §93.1.
relation violatio_fermatiana(pr: Probatio) kind derived {
    label la unofficial "violatio theorematis Fermatiani";
    label ru unofficial "носитель нарушения теоремы Ферма: у основания, модулем не делящегося, степень на единицу меньше модуля не дала единицы";
}

// Антецедент инварианта: испытанию предъявлены модуль и основание.
relation casus_propositus(pr: Probatio) kind derived {
    label la unofficial "casus propositus";
    label ru unofficial "антецедент инварианта: испытанию предъявлены модуль и основание";
}

// Презумируемый вывод: модуль простой. Не строгий вывод и не факт дела —
// поражаемое основание, снимаемое барьером составности.
relation primus(modulus: Integer) kind derived {
    label la unofficial "numerus primus";
    label ru unofficial "модуль презюмируется простым — тест Ферма пройден и составность не установлена; шаг ДОКТРИНАЛЬНЫЙ, обратной теоремы у Гаусса нет";
}
