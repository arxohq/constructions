// --- Вопрос без выбранного прочтения: §156 ------------------------------
//
// Те же факты, что в сцене 02, и тот же вопрос — но контекст не называет
// прочтения. Группа `exactly_one` §155 отказывается смешивать ответы трёх
// определений, и дело получает INTERPRETATION_REQUIRED вместо тихого
// NEITHER, неотличимого от «сведений не хватает».

test "urn:query:chem-acid-base-16-no-reading-selected" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
        }
        assert "ab16-q": openstax.chemistry_acids::species_in_question(entity_ref("urn:case:chem:hcl")) { origin case_input; }
        assert "ab16-1": openstax.chemistry_acids::donates_proton(entity_ref("urn:case:chem:hcl")) { origin case_input; }
    }
    evaluate truth(is_acid(entity_ref("urn:case:chem:hcl")));
    expect evaluation_status == INTERPRETATION_REQUIRED;
}

// --- Книга «Построения», глава 14: спор внутри одного прочтения ----------
//
// Под прочтением Брёнстеда дело и утверждает, и опровергает донорность
// одной частицы. Кислотность не получает BOTH: положительной посылке
// правила нужна установленная донорность, а спор её не даёт (та же
// граница, что в сцене 22 словаря OpenStax). Прочтение спор дела в ответ
// не превращает.
test "urn:query:chem-acid-base-17-book-dispute-inside-reading" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
            interpretation BronstedReading;
        }
        assert "ab17-q": openstax.chemistry_acids::species_in_question(entity_ref("urn:case:chem:x")) { origin case_input; }
        assert "ab17-yes": openstax.chemistry_acids::donates_proton(entity_ref("urn:case:chem:x")) { origin case_input; }
        assert "ab17-no": not openstax.chemistry_acids::donates_proton(entity_ref("urn:case:chem:x")) { origin case_input; }
    }
    evaluate truth(is_acid(entity_ref("urn:case:chem:x")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    expect interpretations(BronstedReading);
}
