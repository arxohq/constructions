// Мост §15.2 по ОСНОВАНИЯМ: дело не говорит об электронной паре ни слова,
// основание Льюиса выводится из акцепторности протона.
test "urn:query:chem-acid-base-08-ammonia-lewis-base-via-bridge" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
            interpretation LewisReading;
        }
        assert "ab08-q": openstax.chemistry_acids::species_in_question(entity_ref("urn:case:chem:nh3")) { origin case_input; }
        assert "ab08-1": openstax.chemistry_acids::accepts_proton(entity_ref("urn:case:chem:nh3")) { origin case_input; }
    }
    evaluate truth(is_base(entity_ref("urn:case:chem:nh3")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(BronstedBaseIsLewisBase);
    expect interpretations(LewisReading);
}

