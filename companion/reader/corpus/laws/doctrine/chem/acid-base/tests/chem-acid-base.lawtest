// Дело молчит о том, что BF3 делает в воде, — и определение Аррениуса молчит
// в ответ. why_not называет незакрытую посылку; это НЕ то же самое, что
// сцена 04, где дело отрицает выделение катионов прямо.
test "urn:query:chem-acid-base-11-bf3-arrhenius-why-not" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
            interpretation ArrheniusReading;
        }
        assert "ab11-q": openstax.chemistry_acids::species_in_question(entity_ref("urn:case:chem:bf3")) { origin case_input; }
        assert "ab11-1": openstax.chemistry_acids::accepts_electron_pair(entity_ref("urn:case:chem:bf3")) { origin case_input; }
    }
    evaluate why_not(is_acid(entity_ref("urn:case:chem:bf3")));
    expect truth_status == NEITHER;
    expect blocked_by("ArrheniusReading/AcidIsArrheniusAcid");
    expect interpretations(ArrheniusReading);
}

