// --- Мост §14.1: кислота Аррениуса есть кислота Брёнстеда ----------------
//
// Дело даёт ТОЛЬКО факты Аррениуса — растворимость и катион водорода; о
// переносе протона оно не говорит ни слова. Кислотность по Брёнстеду выводится
// леммой-мостом, и это ровно то, что учебник называет «more general».

test "urn:query:chem-acid-base-14-arrhenius-acid-is-bronsted-acid" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
            interpretation BronstedReading;
        }
        assert "ab14-q": openstax.chemistry_acids::species_in_question(entity_ref("urn:case:chem:hno3")) { origin case_input; }
        assert "ab14-1": openstax.chemistry_acids::dissolves_in_water(entity_ref("urn:case:chem:hno3")) { origin case_input; }
        assert "ab14-2": openstax.chemistry_acids::yields_hydrogen_cation(entity_ref("urn:case:chem:hno3")) { origin case_input; }
    }
    evaluate truth(is_acid(entity_ref("urn:case:chem:hno3")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(ArrheniusAcidIsBronstedAcid);
    expect interpretations(BronstedReading);
}

