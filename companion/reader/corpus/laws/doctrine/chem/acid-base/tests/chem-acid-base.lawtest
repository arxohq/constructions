language "law.core" version "0.2";
package chem.acid_base version "0.1.0";
namespace "urn:chem:clir:acid-base";

// Сцены пакета: один вопрос «кислота ли эта частица» — три ответа по трём
// прочтениям §152, и четвёртый ответ на тот же вопрос без выбранного
// прочтения (§156). Пары стоят по обе стороны каждой границы: HCl кислота по
// Брёнстеду и НЕ кислота по Льюису; BF3 кислота по Льюису и НЕ кислота по
// Брёнстеду; аммиак не кислота ни по Аррениусу, ни по Брёнстеду, но основание
// и по Брёнстеду, и по Льюису; вода — и кислота, и основание в одном
// прочтении.
//
// FALSE_ONLY здесь получается ЯВНЫМ отрицанием дела (`assert not …`), а не
// молчанием: `refuted` в отрицательных головах (DECISION-0088) читает
// установленную ложь, и дело, которое о свойстве не говорит, оставляет ответ
// NEITHER — что и показано сценой why_not.

// --- HCl: кислота по Аррениусу и по Брёнстеду, не кислота по Льюису ------

test "urn:query:chem-acid-base-01-hcl-arrhenius" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
            interpretation ArrheniusReading;
        }
        assert "ab01-q": openstax.chemistry_acids::species_in_question(entity_ref("urn:case:chem:hcl")) { origin case_input; }
        assert "ab01-1": openstax.chemistry_acids::dissolves_in_water(entity_ref("urn:case:chem:hcl")) { origin case_input; }
        assert "ab01-2": openstax.chemistry_acids::yields_hydrogen_cation(entity_ref("urn:case:chem:hcl")) { origin case_input; }
    }
    evaluate truth(is_acid(entity_ref("urn:case:chem:hcl")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(ArrheniusAcidYieldsHydrogenCation);
    expect interpretations(ArrheniusReading);
}

test "urn:query:chem-acid-base-02-hcl-bronsted" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
            interpretation BronstedReading;
        }
        assert "ab02-q": openstax.chemistry_acids::species_in_question(entity_ref("urn:case:chem:hcl")) { origin case_input; }
        assert "ab02-1": openstax.chemistry_acids::donates_proton(entity_ref("urn:case:chem:hcl")) { origin case_input; }
    }
    evaluate truth(is_acid(entity_ref("urn:case:chem:hcl")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(BronstedAcidDonatesProton);
    expect interpretations(BronstedReading);
}

// Граница: та же частица, то же дело — и ПРОТИВОПОЛОЖНЫЙ ответ, потому что
// вопрос задан по другому определению. §15.2 называет кислотой Льюиса
// акцептор пары; HCl её не принимает, и дело это утверждает прямо.
test "urn:query:chem-acid-base-03-hcl-lewis-refuted" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
            interpretation LewisReading;
        }
        assert "ab03-q": openstax.chemistry_acids::species_in_question(entity_ref("urn:case:chem:hcl")) { origin case_input; }
        assert "ab03-1": openstax.chemistry_acids::donates_proton(entity_ref("urn:case:chem:hcl")) { origin case_input; }
        assert "ab03-2": not openstax.chemistry_acids::accepts_electron_pair(entity_ref("urn:case:chem:hcl")) { origin case_input; }
    }
    evaluate truth(is_acid(entity_ref("urn:case:chem:hcl")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(NotLewisAcidWithoutAcceptance);
    expect interpretations(LewisReading);
}

// --- Аммиак: не кислота по Аррениусу, основание по Брёнстеду и по Льюису --

test "urn:query:chem-acid-base-04-ammonia-arrhenius-not-acid" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
            interpretation ArrheniusReading;
        }
        assert "ab04-q": openstax.chemistry_acids::species_in_question(entity_ref("urn:case:chem:nh3")) { origin case_input; }
        assert "ab04-1": openstax.chemistry_acids::dissolves_in_water(entity_ref("urn:case:chem:nh3")) { origin case_input; }
        assert "ab04-2": not openstax.chemistry_acids::yields_hydrogen_cation(entity_ref("urn:case:chem:nh3")) { origin case_input; }
        assert "ab04-3": not openstax.chemistry_acids::yields_hydroxide_anion(entity_ref("urn:case:chem:nh3")) { origin case_input; }
    }
    evaluate truth(is_acid(entity_ref("urn:case:chem:nh3")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(NotArrheniusAcidWithoutHydrogenCation);
    expect interpretations(ArrheniusReading);
}

// Аммиак не основание и по Аррениусу: гидроксид-анионов в воде он не даёт —
// их даёт продукт его реакции с водой. Пара к сцене 06, где по Льюису он
// основание.
test "urn:query:chem-acid-base-05-ammonia-arrhenius-not-base" {
    given {
        context {
            decision_time @2026-09-06T12:00:00Z;
            knowledge_time @2026-09-06T12:00:00Z;
            legal_time @2026-09-06;
            timezone "UTC";
            interpretation ArrheniusReading;
        }
        assert "ab05-q": openstax.chemistry_acids::species_in_question(entity_ref("urn:case:chem:nh3")) { origin case_input; }
        assert "ab05-1": openstax.chemistry_acids::dissolves_in_water(entity_ref("urn:case:chem:nh3")) { origin case_input; }
        assert "ab05-2": not openstax.chemistry_acids::yields_hydroxide_anion(entity_ref("urn:case:chem:nh3")) { origin case_input; }
    }
    evaluate truth(is_base(entity_ref("urn:case:chem:nh3")));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(NotArrheniusBaseWithoutHydroxide);
    expect interpretations(ArrheniusReading);
}

